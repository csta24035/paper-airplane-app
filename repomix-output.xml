import { useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";
import { getAllAirplanes } from "../db/indexedDb";
import type {
  Airplane,
  Instruction,
} from "../types/airplane";

function DetailPage() {
  const { id } = useParams();

  const [airplane,
setAirplane]=
useState<Airplane | null>(
null
);

  useEffect(() => {
    load();
  }, []);

  async function load() {
    const airplanes =
      await getAllAirplanes();

    const target =
airplanes.find(
(a: Airplane)=> a.id === id
      );

    setAirplane(target);
  }

  if (!airplane) {
    return (
      <div style={{ padding: 20 }}>
        <p>読み込み中...</p>
      </div>
    );
  }

  return (
    <div
      style={{
        padding: 20,
      }}
    >
      <Link to="/">
        ← 一覧へ戻る
